{
  "expo": {
    "name": "AMS App",
    "slug": "ams-mobile",
    "version": "1.10.3",
    "orientation": "portrait",
    "icon": "./src/assets/images/ams-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/images/icon1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "icon": "./src/assets/images/icon1024.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera."
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 30000,
      "url": "https://u.expo.dev/e7451209-961c-4d6f-96e7-3b9f21984b4a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/ams-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.thjhams.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 26,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "com.android.launcher.permission.INSTALL_SHORTCUT"
      ]
    },
    "web": {
      "favicon": "./src/assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e7451209-961c-4d6f-96e7-3b9f21984b4a"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  },
  "author": {
    "name": "Jirapong Pasuknirun",
    "email": "j.pasuknirun@gmail.com",
    "url": "https://expo.io/@jakkajee11/ams-mobile"
  }
}
