{
  "expo": {
    "name": "AMS App",
    "slug": "ams-mobile",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./src/assets/images/ams-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/images/icon1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "icon": "./src/assets/images/icon1024.png"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 30000,
      "url": "https://expo.io/@jakkajee11/ams-mobile"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/ams-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.thjhams.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 18,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "com.android.launcher.permission.INSTALL_SHORTCUT"
      ]
    },
    "web": {
      "favicon": "./src/assets/images/favicon.png"
    }
  },
  "author": {
    "name": "Jirapong Pasuknirun",
    "email": "j.pasuknirun@gmail.com",
    "url": "https://expo.io/@jakkajee11/ams-mobile"
  }
}
