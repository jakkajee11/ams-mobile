{
  "expo": {
    "name": "AMS Mobile App",
    "slug": "ams-mobile",
    "version": "2.0.10",
    "orientation": "portrait",
    "icon": "./src/assets/images/ams-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/icon1024.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/icon1024.png"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-web-browser"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "extra": {
      "eas": {
        "projectId": "c46bb8d7-6e3c-483c-bbb1-cf2f0cdc7dad"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/ams-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.amsthjh.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "com.android.launcher.permission.INSTALL_SHORTCUT"
      ]
    },
    "web": {
      "favicon": "./src/assets/images/favicon.png"
    }
  }
}
